# ============================================================
#  Vizag Traffic & Pollution Dashboard — Environment Variables
#  Copy this file to .env and fill in your API keys
# ============================================================

# ── AQI Data ──────────────────────────────────────────────────────
# Free token: https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# Free key: https://openweathermap.org/api
OWM_API_KEY=your_owm_api_key_here

# ── Traffic Data ──────────────────────────────────────────────────
# Free key (no CC required): https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# ── Database ──────────────────────────────────────────────────────
# For local dev, SQLite is used automatically (no config needed)
# For production, set this to your Supabase PostgreSQL URL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/vizag_db
DATABASE_URL=sqlite+aiosqlite:///./data/vizag.db

# ── Application ───────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300    # How often to fetch new data (5 min)
API_HOST=0.0.0.0
API_PORT=8000

# ── Vizag Coordinates ─────────────────────────────────────────────
VIZAG_LAT=17.6868
VIZAG_LON=83.2185
VIZAG_CITY=visakhapatnam

# ── Alert Thresholds (AQI) ────────────────────────────────────────
ALERT_GOOD_MAX=50
ALERT_MODERATE_MAX=100
ALERT_UNHEALTHY_SENSITIVE_MAX=150
ALERT_UNHEALTHY_MAX=200
ALERT_VERY_UNHEALTHY_MAX=300

# ── Email Alerts (SendGrid) ───────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key_here
ALERT_FROM_EMAIL=alerts@vizag-dashboard.app

# ── Supabase (Production Auth) ────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
